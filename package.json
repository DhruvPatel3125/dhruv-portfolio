{
  "name": "professional-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=client && node -e \"import fs from 'fs'; fs.cpSync('client/dist', 'dist', { recursive: true });\"",
    "start": "npm start --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.13.0",
    "mongoose": "^9.7.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5"
  }
}
